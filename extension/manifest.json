{
  "manifest_version": 3,
  "name": "JobMatch AI — Personal Job Navigator",
  "version": "1.0.0",
  "description": "Automated, high-precision job application copilot for Naukri with smart salary filtering and 100% criteria matching.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open JobMatch AI Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.naukri.com/*",
    "https://*.naukri.com/*",
    "http://127.0.0.1:3099/*",
    "http://localhost:3099/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/*",
        "https://*.naukri.com/*"
      ],
      "js": [
        "content/naukri-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
